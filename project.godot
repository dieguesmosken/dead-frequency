; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dead Frequency Internal-Pre Alpha"
config/description="Simulador de entrega e sobrevivência em 1ª pessoa — van anos 90, física tátil, UI diegética."
config/tags=PackedStringArray("pre_release")
run/main_scene="res://Scenes/UI/splash_screen.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

GameSettings="*res://Scripts/Core/GameSettings.cs"
AudioManager="*res://Scripts/Audio/AudioManager.cs"
NetClient="*res://Scripts/Net/NetClient.cs"
PlayerInventory="*res://Scripts/Items/PlayerInventory.cs"
TouchControls="*res://Scripts/UI/TouchControls.cs"
StoryManager="*res://Scripts/Story/StoryManager.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="DeadFrequency"

